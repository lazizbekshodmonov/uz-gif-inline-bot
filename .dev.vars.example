# Bu faylni `.dev.vars` deb nusxalang va qiymatlarni to'ldiring.
# `.dev.vars` .gitignore da — u hech qachon repoga tushmaydi.
# Lokal sinov (`wrangler dev`) uchun ishlatiladi.
#
# Productionda esa bu qiymatlar Cloudflare Secrets'da turadi:
#   npx wrangler secret put BOT_TOKEN
#   npx wrangler secret put WEBHOOK_SECRET

# BotFather bergan token
BOT_TOKEN="123456789:AAH..."

# Tasodifiy satr. Yaratish:  openssl rand -hex 16
# setWebhook dagi secret_token bilan AYNAN bir xil bo'lishi shart.
WEBHOOK_SECRET="a1b2c3d4e5f6a7b8c9d0e1f2a3b4c5d6"
